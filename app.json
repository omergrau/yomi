{
  "expo": {
    "name": "עוזר אישי",
    "slug": "yomi",
    "scheme": "yomi",
    "version": "2.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.yomi",
      "infoPlist": {
        "ExpoLocalization_forcesRTL": true
      }
    },
    "android": {
      "package": "app.yomi",
      "versionCode": 5,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#2A7D4F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.READ_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-status-bar",
      "expo-build-properties",
      "expo-notifications",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FCFCFA",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#16181B"
          }
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "עוזר אישי מציג את האירועים מהיומן שלך בלו״ז היומי."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "49443610-f911-4331-bbf9-faa8851dd37d"
      }
    },
    "owner": "omergrau"
  }
}
